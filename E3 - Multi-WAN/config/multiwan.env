# Variables de entorno y configuracion general para el nodo E3

# Interfaz del ISP1: conexion wifi principal de la laptop
WAN1_IFACE="wlp3s0"
WAN1_NAME="ISP1"

# Interfaz del ISP2: antena wifi usb o celular compartido por usb
WAN2_IFACE="wlxc006c3bf886a"
WAN2_NAME="ISP2"

# Interfaz hacia E5 (cable ethernet directo punto a punto)
LAN_IFACE="eno1"
LAN_IP="192.168.81.1/30"
E5_GATEWAY="192.168.81.2"

# Tablas de rutas separadas para cada proveedor en iproute2
TABLE_ISP1="100"
TABLE_ISP2="200"

# Marcas en hexadecimal para identificar los paquetes en nftables
FWMARK_ISP1="0x100"
FWMARK_ISP2="0x200"

# Prioridades de ip rule (usamos 10100 y 10200 para no chocar con tailscale ni con la tabla main)
IP_RULE_PRIO_ISP1="10100"
IP_RULE_PRIO_ISP2="10200"

# Parametros para el demonio de failover (monitorea cada 2 segundos con timeout de 1s)
FAILOVER_INTERVAL_SEC="2"
FAILOVER_TIMEOUT_SEC="1"
CHECK_TARGET_1="8.8.8.8"
CHECK_TARGET_2="1.1.1.1"

# Ruta base calculada de forma relativa para que funcione en cualquier carpeta
NODE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Ubicacion de los archivos de politicas y logs
POLICIES_FILE="${POLICIES_FILE:-${NODE_DIR}/config/policies.txt}"
LOG_FILE="${LOG_FILE:-${NODE_DIR}/failover.log}"
POLICY_LOG_FILE="${POLICY_LOG_FILE:-${NODE_DIR}/policies_applied.log}"
