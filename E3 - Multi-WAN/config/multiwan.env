# ==============================================================================
# XelajuNetwork - Parametros de Entorno Multi-WAN (Estudiante 3)
# ==============================================================================

# Interfaces de Red WAN
# ISP 1 (Por defecto: interfaz WiFi del equipo anfitrion)
WAN1_IFACE="wlp3s0"
WAN1_NAME="ISP1"

# ISP 2 (Adaptador WiFi USB compartido)
WAN2_IFACE="wlxc006c3bf886a"
WAN2_NAME="ISP2"

# Interfaz hacia la red interna (Firewall E5 - subred 192.168.81.0/30)
# Para conexion fisica por cable Ethernet a la laptop de E5 usa "eno1"
LAN_IFACE="eno1"
LAN_IP="192.168.81.1/30"
E5_GATEWAY="192.168.81.2"

# Tablas de enrutamiento personalizadas (iproute2)
TABLE_ISP1="100"
TABLE_ISP2="200"

# Marcas de firewall para Policy-Based Routing (fwmark)
FWMARK_ISP1="0x100"
FWMARK_ISP2="0x200"

# Prioridades de reglas ip rule (por encima de Tailscale [5210-5270] y antes de main [32766])
IP_RULE_PRIO_ISP1="10100"
IP_RULE_PRIO_ISP2="10200"

# Parametros del Demonio de Failover
FAILOVER_INTERVAL_SEC="2"
FAILOVER_TIMEOUT_SEC="1"
CHECK_TARGET_1="8.8.8.8"
CHECK_TARGET_2="1.1.1.1"

# Directorio base del nodo E3 (calculado dinamicamente para portabilidad)
NODE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Archivos de politicas y logs
POLICIES_FILE="${POLICIES_FILE:-${NODE_DIR}/config/policies.txt}"
LOG_FILE="${LOG_FILE:-${NODE_DIR}/failover.log}"
POLICY_LOG_FILE="${POLICY_LOG_FILE:-${NODE_DIR}/policies_applied.log}"
