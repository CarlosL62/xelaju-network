# Suricata local rules used by E5 in the documented IDS tests.
# SID 1000001: ICMP echo requests observed at the perimeter.
# Active rules must still be compared with /etc/suricata/rules/local.rules on E5.

alert icmp any any -> any any (msg:"ICMP Echo Request detectado"; itype:8; sid:1000001; rev:1;)
