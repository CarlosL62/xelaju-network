<mxCell id="tx_14" value='&lt;b&gt;Qué decide E5 en el paso ④&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b style="color:#1f6fd6"&gt;VPN-ADMIN&lt;/b&gt; (10.200.10.0/24): VLAN 10, 20, 30 y 40 e Internet.&lt;br&gt;&lt;br&gt;&lt;b style="color:#b85450"&gt;VPN-USERS&lt;/b&gt; (10.200.20.0/24): solo VLAN 20 y la Intranet (192.168.30.20, TCP 80 y 443); bloqueado hacia VLAN 10, resto de servidores y VLAN 40.' style="text;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=12;fontColor=#333333;fillColor=#fff8e6;strokeColor=#d79b00;rounded=1;arcSize=20;" vertex="1" parent="1"><mxGeometry x="610" y="430" width="270" height="235" as="geometry"/></mxCell>
<mxCell id="tx_15" value="&lt;b&gt;Anti-suplantación en wg0&lt;/b&gt;&lt;br&gt;cada peer solo puede usar su dirección /32 (AllowedIPs)" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=12;fontColor=#333333;fillColor=#f6f1f9;strokeColor=#9673a6;rounded=1;arcSize=20;" vertex="1" parent="1"><mxGeometry x="640" y="140" width="240" height="85" as="geometry"/></mxCell>
