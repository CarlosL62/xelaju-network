# ==============================================================================
# XelajuNetwork - parámetros de direccionamiento de E4 (VPN/DMZ) usados por scripts/setup_e4.sh
# ==============================================================================
# Estos valores son la parte de E4 del plan de direccionamiento del proyecto. Si el
# plan cambia, este es el único archivo que hay que actualizar.
# Toda variable puede sobrescribirse desde el entorno o con --uplink.

# Interfaz de este equipo cableada a E5. Depende del hardware, por eso nunca se
# adivina: este valor lo confirmó E4 (tarjeta integrada). Se sobrescribe con --uplink.
: "${UPLINK_IFACE:=enp1s0}"

# link_e4_e5 (192.168.83.0/30): E5 es .1, E4 es .2
: "${UPLINK_IP:=192.168.83.2/30}"
: "${UPLINK_GW:=192.168.83.1}"

# DMZ 172.16.10.0/24: la puerta de enlace de E4 es .1 y WEB01 es .10, ambas en una
# interfaz dummy de este equipo (no hay segunda tarjeta de red física)
: "${DMZ_IFACE:=dmz0}"
: "${DMZ_GW_IP:=172.16.10.1/24}"
: "${WEB01_IP:=172.16.10.10/24}"

# WireGuard: wg0 se levanta desde /etc/wireguard/wg0.conf (contiene la llave privada
# y nunca se versiona). Estas son las direcciones que debe llevar.
: "${WG_IFACE:=wg0}"
: "${WG_ADDRS:=10.200.10.1/24 10.200.20.1/24}"

# Reenvío de IP persistente (E4 enruta entre el enlace a E5, wg0 y la DMZ)
: "${SYSCTL_CONF:=/etc/sysctl.d/99-xelaju-e4.conf}"

# ------------------------------------------------------------------------------
# Peers de prueba de WireGuard (los usa scripts/gen_peers.sh), según el plan de
# direccionamiento. El prefijo del nombre decide el tipo: admin* = VPN-ADMIN,
# cualquier otro = VPN-USERS.
# ------------------------------------------------------------------------------
: "${WG_PEERS:=admin1:10.200.10.10 admin2:10.200.10.11 user1:10.200.20.10 user2:10.200.20.11 user3:10.200.20.12}"
: "${WG_PORT:=51820}"
# Llave pública del servidor E4 (información pública, ya está en el README)
: "${WG_SERVER_PUBKEY:=NRYE/+iGxsyNkbCjqqkn1pvFAHBXu0KfnzvA5CYYTQ4=}"
# HOST:PUERTO al que marcan los clientes. Vacío -> se escribe un marcador visible.
: "${WG_ENDPOINT:=}"
# Full Tunnel para todos los clientes
: "${WG_CLIENT_ALLOWED_IPS:=0.0.0.0/0, ::/0}"
# DNS que se escribe en cada perfil de cliente. Solo 8.8.8.8: medido desde la red del grupo,
# es el único resolvedor que respondió por ambos ISP (ISP2 descartó el UDP/53 hacia 1.1.1.1,
# 9.9.9.9, 8.8.4.4, 208.67.222.222, 94.140.14.14 y 4.2.2.2). Un valor explícitamente vacío
# (WG_CLIENT_DNS=) = sin línea DNS.
: "${WG_CLIENT_DNS=8.8.8.8}"
: "${WG_CONF_DIR:=/etc/wireguard}"
# Dónde viven las llaves privadas de los peers y los perfiles de cliente. Vacío -> el
# ~/.local/share/xelaju-e4/wireguard del usuario que invoca. Debe estar FUERA del repositorio git.
: "${E4_KEYS_DIR:=}"
