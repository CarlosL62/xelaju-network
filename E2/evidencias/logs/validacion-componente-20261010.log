## [5] Tabla nftables: ip squid_transparent
table ip squid_transparent {
	chain input {
		type filter hook input priority filter; policy accept;
		iif "lo" accept
		tcp dport 8080 ip saddr != 192.168.10.0/24 drop
	}

	chain prerouting {
		type nat hook prerouting priority dstnat; policy accept;
		ip saddr { 10.200.10.0/24, 10.200.20.0/24 } tcp dport 80 accept
		ip daddr 172.16.10.0/24 tcp dport 80 accept
		ip daddr 10.200.10.0/24 tcp dport 80 accept
		ip daddr 10.200.20.0/24 tcp dport 80 accept
		tcp dport 80 redirect to :3129
	}

	chain output {
		type nat hook output priority dstnat; policy accept;
		ip daddr != 127.0.0.0/8 tcp dport 80 meta skuid 13 accept
		ip saddr { 10.200.10.0/24, 10.200.20.0/24 } tcp dport 80 accept
		ip daddr 172.16.10.0/24 tcp dport 80 accept
		ip daddr 10.200.10.0/24 tcp dport 80 accept
		ip daddr 10.200.20.0/24 tcp dport 80 accept
		tcp dport 80 redirect to :3129
	}
}

