# ==============================================================================
# XelajuNetwork - Parametros del Proxy Squid (Estudiante 2)
# ==============================================================================

# Puertos
SQUID_HTTP_PORT="3128"      # Puerto explicito (admin/pruebas)
SQUID_INTERCEPT_PORT="3129" # Puerto interceptado (modo transparente)
PORTAL_PORT="8080"          # Portal web de consulta de logs

# Interfaces/redes (alineado con core/ADDRESSING.yaml PR #4)
ADMIN_NET="192.168.10.0/24"
USERS_NET="192.168.20.0/24"
SERVERS_NET="192.168.30.0/24"
MGMT_NET="192.168.40.0/24"
DMZ_NET="172.16.10.0/24"
VPN_ADMIN_NET="10.200.10.0/24"
VPN_USERS_NET="10.200.20.0/24"
E2_UPSTREAM="192.168.82.2"
E2_DOWNSTREAM="192.168.84.1"
E5_UPSTREAM_GW="192.168.82.1"
E1_DOWNSTREAM_GW="192.168.84.2"

# Archivos de listas de bloqueo (rutas destino en el equipo)
ADMINS_BLACKLIST="/etc/squid/lists/admins_blacklist"
USERS_BLACKLIST="/etc/squid/lists/users_blacklist"

# Log
ACCESS_LOG="/var/log/squid/access.log"
CACHE_LOG="/var/log/squid/cache.log"
